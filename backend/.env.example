# ---------------------------------------------------------------------------
# AtmosIQ — backend environment
--------

APP_ENV=development

SECRET_KEY=change-me


TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=


# Local fallback, used when the two Turso values above are empty.
DATABASE_URL=sqlite:///./atmosiq.db
# PostgreSQL example (no code changes required):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/atmosiq


# Google AI  (REQUIRED for live Gemini analysis, OPTIONAL for the demo)
# Get a key at https://aistudio.google.com/apikey

GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Optional providers. All are unnecessary for the prototype:
# weather and air quality default to Open-Meteo, which needs no key.
# ---------------------------------------------------------------------------
WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_EARTH_ENGINE_PROJECT=

# ---------------------------------------------------------------------------
# Deployment node identity (ISO 3166-1 alpha-2 / ISO 3166-2).
# Change these two values to run this same codebase as another BRICS node.
# ---------------------------------------------------------------------------
DEFAULT_COUNTRY_CODE=IN
DEFAULT_REGION_CODE=IN-DL

# Uploads
MAX_UPLOAD_BYTES=8388608
ACCESS_TOKEN_EXPIRE_MINUTES=720
