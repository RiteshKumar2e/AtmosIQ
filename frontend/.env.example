# Base URL of the AtmosIQ FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Leaflet raster tile URL template.
# Leave blank to use OpenStreetMap tiles, which need no API key.
# Example (MapTiler):
#   https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_STYLE_URL=
